#-----------------------------------------------------------------------------
# OS / System Files
#-----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

#-----------------------------------------------------------------------------
# IDE and Editor Files
#-----------------------------------------------------------------------------
# Visual Studio
.vs/
*.VC.db
*.VC.opendb
*.sln
*.suo
*.user
*.vcxproj.filters
*.vcxproj.user

# Visual Studio Code
.vscode/

# JetBrains Rider / CLion
.idea/
*.sln.DotSettings.user

# Xcode
*.xcodeproj
*.xcworkspace
*.xcworkspacedata

#-----------------------------------------------------------------------------
# Unreal Engine - Generated Folders
# These directories are generated by the engine and editor.
#-----------------------------------------------------------------------------
Binaries/*
Plugins/**/Binaries/*

Build/*
# Whitelist PakBlacklist files and icons, which might be checked in.
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

DerivedDataCache/*
Intermediate/*
Plugins/**/Intermediate/*

Saved/*

#-----------------------------------------------------------------------------
# Unreal Engine - Compiled Files & Libraries
#-----------------------------------------------------------------------------
# Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Static libraries
*.lai
*.la
*.a
*.lib

# Dynamic libraries
*.so
*.dylib
*.dll

# Executables
*.exe
*.out
*.app
*.ipa

# Fortran module files
*.mod

# Other generated files
*_BuiltData.uasset
*.opensdf
*.sdf

#-----------------------------------------------------------------------------
# Other Project-Specific Ignores
#-----------------------------------------------------------------------------
# Precompiled art assets (if you only want source .psd, .blend, etc. in git)
SourceArt/**/*.png
SourceArt/**/*.tga

#-----------------------------------------------------------------------------
# MyWasmLogic - AssemblyScript Project
# Rules for the WASM project located in the MyWasmLogic/ directory.
#-----------------------------------------------------------------------------
MyWasmLogic/node_modules/
MyWasmLogic/build/
MyWasmLogic/coverage/
MyWasmLogic/tsconfig.tsbuildinfo
MyWasmLogic/npm-debug.log*
MyWasmLogic/yarn-error.log
MyWasmLogic/yarn-debug.log
!Content/*.wasm